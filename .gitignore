__pycache__/
*.py[cod]
node_modules/
dist/
*.tsbuildinfo

# Written by whichever npm install ran last, host or container. Nothing needs it:
# every install path uses `npm install` rather than `npm ci`, and web/package.json
# pins every direct dependency exactly.
web/package-lock.json

# Local runner secrets
runner/.env

# Deployment-specific compose overrides
runner/compose.override.yml
deployments/compose.override.yml
deployments/.env

# Local skill-discovery links; the skills themselves live in skills/
.claude/

# Run ID the interim tmp/ scripts pass between themselves; goes with tmp/ (P1-051)
tmp/.last-run
