# syntax=docker/dockerfile:1
#
# Build context is the repository root:
#   docker build -f deployments/Dockerfile.winchd .

FROM golang:1.24-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac AS build
WORKDIR /src

# The runner bind-mounts the host repo here under a different uid, and git then
# refuses to report VCS status, which fails `go build`.
RUN git config --global --add safe.directory /src

# Dependencies resolve from the committed go.mod/go.sum only. -mod=readonly
# fails the build rather than silently rewriting them.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd/ cmd/
COPY internal/ internal/
COPY pkg/ pkg/
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -mod=readonly -o /out/winchd ./cmd/winchd && \
    CGO_ENABLED=0 go build -mod=readonly -o /out/fake-harness ./cmd/fake-harness

FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS web-build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 winch

COPY --from=build /out/winchd /usr/local/bin/winchd
# The fake harness is launched by name from PATH by the harness adapter's
# launch spec, so it must be installed rather than merely built.
COPY --from=build /out/fake-harness /usr/local/bin/fake-harness
COPY --from=web-build /web/dist /usr/share/winch/web

USER winch
WORKDIR /home/winch
EXPOSE 8080
ENTRYPOINT ["winchd"]
