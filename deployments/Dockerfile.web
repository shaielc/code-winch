# syntax=docker/dockerfile:1
#
# Build context is the repository root:
#   docker build -f deployments/Dockerfile.web .

FROM node:22-bookworm-slim AS build
WORKDIR /app

# The workspace commits no lockfile; every direct dependency in package.json is
# pinned to an exact version, so install resolves deterministically without one.
COPY web/package.json ./
RUN npm install --no-audit --no-fund

COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deployments/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
