{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-winch.invalid/schemas/workplan-tasks.schema.json",
  "title": "Code Winch workplan task tracker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status_values", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "status_values": {
      "const": ["pending", "in_progress", "blocked", "completed"]
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "phase",
        "phase_name",
        "status",
        "depends_on",
        "owner",
        "blocked_reason",
        "brief"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^P[0-5]-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "phase": { "type": "integer", "minimum": 0, "maximum": 5 },
        "phase_name": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["pending", "in_progress", "blocked", "completed"]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^P[0-5]-[0-9]{3}$" }
        },
        "owner": { "type": ["string", "null"] },
        "blocked_reason": { "type": ["string", "null"] },
        "brief": { "type": "string", "pattern": "^phase-[0-5]/.+\\.md$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "blocked" } } },
          "then": {
            "properties": { "blocked_reason": { "type": "string", "minLength": 1 } }
          },
          "else": { "properties": { "blocked_reason": { "type": "null" } } }
        }
      ]
    }
  }
}
