{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-winch.dev/schemas/events/v1/canonical-event.schema.json",
  "title": "Code Winch canonical event v1",
  "type": "object",
  "required": [
    "eventId",
    "runId",
    "sequence",
    "occurredAt",
    "kind",
    "schemaVersion",
    "source",
    "sensitivity",
    "payload",
    "extensions"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "control-plane",
            "runner",
            "harness",
            "workflow"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "sensitivity": {
      "enum": [
        "public",
        "operational",
        "user-content",
        "confidential",
        "secret"
      ]
    },
    "payload": {
      "type": "object"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]*/v[1-9][0-9]*$"
      },
      "additionalProperties": {}
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run.lifecycle"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/lifecycle"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "stream.raw"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/rawStream"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "message.created"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/message"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool.call"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/toolCall"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool.result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/toolResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "approval.requested"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/approvalRequest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "approval.resolved"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/approvalResolution"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "file.changed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/fileChange"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "artifact.published"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "usage.recorded"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/usage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "diagnostic.emitted"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "workflow.linked"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/workflowLink"
          }
        }
      }
    }
  ],
  "$defs": {
    "lifecycle": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "created",
            "queued",
            "preparing",
            "running",
            "stopping",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "rawStream": {
      "type": "object",
      "required": [
        "stream",
        "encoding",
        "data"
      ],
      "properties": {
        "stream": {
          "enum": [
            "stdout",
            "stderr",
            "terminal"
          ]
        },
        "encoding": {
          "enum": [
            "utf-8",
            "base64"
          ]
        },
        "data": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "required": [
        "messageId",
        "role",
        "content"
      ],
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "system"
          ]
        },
        "content": {
          "type": "string"
        },
        "commandId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "toolCall": {
      "type": "object",
      "required": [
        "toolCallId",
        "name",
        "arguments"
      ],
      "properties": {
        "toolCallId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {}
      },
      "additionalProperties": true
    },
    "toolResult": {
      "type": "object",
      "required": [
        "toolCallId",
        "status",
        "result"
      ],
      "properties": {
        "toolCallId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "result": {}
      },
      "additionalProperties": true
    },
    "approvalRequest": {
      "type": "object",
      "required": [
        "approvalId",
        "action",
        "summary"
      ],
      "properties": {
        "approvalId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "approvalResolution": {
      "type": "object",
      "required": [
        "approvalId",
        "decision"
      ],
      "properties": {
        "approvalId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "approved",
            "denied",
            "cancelled"
          ]
        },
        "commandId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "fileChange": {
      "type": "object",
      "required": [
        "changeId",
        "operation",
        "path"
      ],
      "properties": {
        "changeId": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "created",
            "modified",
            "deleted",
            "renamed"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "previousPath": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifactId",
        "mediaType",
        "size",
        "digest"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": [
        "unit",
        "quantity"
      ],
      "properties": {
        "unit": {
          "enum": [
            "input-token",
            "output-token",
            "cached-token",
            "wall-millisecond"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "relatedEventId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "workflowLink": {
      "type": "object",
      "required": [
        "workflowId",
        "stepId",
        "relation"
      ],
      "properties": {
        "workflowId": {
          "type": "string",
          "minLength": 1
        },
        "stepId": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "started",
            "produced",
            "awaited",
            "completed",
            "failed"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  }
}
